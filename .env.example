LISTEN=0.0.0.0:8787
DEVICE_TOKEN=replace-with-a-random-personal-device-token
CODEX_BIN=/home/lake/.local/bin/codex
CHROMIUM_BIN=/path/to/chromium
RUST_LOG=passport_voice=info
# Persistent voice notes, relative to the service working directory or absolute.
VOICE_CONTEXT_DIR=data/context
VOICE_TIMEZONE=Asia/Shanghai
# For a Codex wrapper/npm install outside standard system runtime directories:
VOICE_CODEX_RUNTIME_DIR=/home/lake/.local/share/codex-cli
